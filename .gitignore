# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# downloaded map images (scripts/fetch-airport-images.mjs default output)
/maps-import/

# raw article archives waiting to be imported as public/blog/<slug>/ folders
/imports/

# content-export default output — documents live in the database now, so an
# exported tree dropped in the repo is a backup, never a commit candidate
/content/

# cached Overpass responses (scripts/generate-airport-maps.mjs scratch)
/data/osm/

# flight dataset refresh scratch (scripts/fetch-flights.mjs)
/data/flights.json.gz.tmp

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the documented template
!.env.example

.idea

seo

.backup
/dist/
.vinext/
