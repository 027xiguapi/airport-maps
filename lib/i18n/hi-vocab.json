{
  "_readme": [
    "हिन्दी शब्दावली उन संरचित डेटा के लिए जिन्हें डेटाबेस केवल चीनी,",
    "पारंपरिक चीनी और अंग्रेज़ी में संग्रहीत करता है। हिन्दी अंग्रेज़ी कॉलम को",
    "आधार बनाकर रेंडरिंग के समय बंद शब्दावली का अनुवाद करती है। अनुपलब्ध मान",
    "अंग्रेज़ी पर लौटते हैं, इसलिए नया हवाई अड्डा या शहर कभी चीनी पाठ नहीं",
    "दिखाएगा।"
  ],
