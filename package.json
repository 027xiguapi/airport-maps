{
  "name": "airport-maps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "typecheck": "tsc --noEmit",
    "db:create": "node scripts/db-create.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:extensions": "node scripts/db-apply-sql.mjs db/extensions.sql",
    "db:custom": "node scripts/db-apply-sql.mjs db/custom.sql",
    "db:setup": "node scripts/db-create.mjs && node scripts/db-apply-sql.mjs db/extensions.sql && drizzle-kit migrate && node scripts/db-apply-sql.mjs db/custom.sql",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/db-create.mjs --reset && node scripts/db-apply-sql.mjs db/extensions.sql && drizzle-kit migrate && node scripts/db-apply-sql.mjs db/custom.sql && node scripts/seed.mjs",
    "db:verify": "node scripts/verify.mjs",
    "data:world-airports": "node scripts/prepare-world-airports.mjs"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
