# Copy to .env.local and adjust for your PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/airport_maps
# Salt for the comment rate-limit hashes. Set any long random string in
# production; changing it only resets the per-IP counters, never the comments.
COMMENTS_IP_SALT=replace-with-a-long-random-string
