# Copy to .env.local and adjust for your PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/airport_maps
# Salt for the comment rate-limit hashes. Set any long random string in
# production; changing it only resets the per-IP counters, never the comments.
COMMENTS_IP_SALT=replace-with-a-long-random-string

# --------------------------------------------------------------- Google login
# OAuth 2.0 Web application credentials from Google Cloud Console:
#   APIs & Services → Credentials → Create credentials → OAuth client ID
# Leave both empty to keep the site fully usable; the login page then explains
# that sign-in is not configured instead of failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. The exact callback URL registered in Google Cloud. Defaults to
# <public origin>/api/auth/google/callback — set it when the app sits behind a
# proxy whose forwarded host differs from the address Google should call.
GOOGLE_REDIRECT_URI=

# ------------------------------------------------------------ administrator
# Comma-separated Google emails allowed into /admin/deals. Empty means nobody
# is an administrator. Every admin page and API call checks this allowlist.
ADMIN_EMAILS=

# --------------------------------------------------------------- airfare deals
# Salts for the per-user/per-IP submission quotas and login-session review.
# Any long random string; they never encrypt anything user-visible.
DEALS_IP_SALT=
AUTH_IP_SALT=
