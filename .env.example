# Copy to .env.local and adjust for your PostgreSQL instance.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/airport_maps
# Salt for the comment rate-limit hashes. Set any long random string in
# production; changing it only resets the per-IP counters, never the comments.
COMMENTS_IP_SALT=replace-with-a-long-random-string

# --------------------------------------------------------------- Google login
# NextAuth (Auth.js) Google provider. Create a Web application OAuth client in
# Google Cloud Console and register this redirect URI:
#   http(s)://<host>/api/auth/callback/google
# Leave the credentials empty to keep the site fully usable; the login page
# then explains that sign-in is not configured instead of failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required by NextAuth: `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=
# Optional canonical origin in production when a reverse proxy hides the real
# host/protocol (NextAuth otherwise derives it from the request):
# AUTH_URL=https://worldairportmap.com

# ------------------------------------------------------------ administrator
# Comma-separated Google emails allowed into /admin/deals. Empty means nobody
# is an administrator. Every admin page and API call checks this allowlist.
ADMIN_EMAILS=

# --------------------------------------------------------------- airfare deals
# Salt for the per-user/per-IP submission quotas. Any long random string; it
# never encrypts anything user-visible.
DEALS_IP_SALT=

# --------------------------------------------------------------- affiliate links
# Applied to machine-collected fares only (deals.kind = 'fare'). An explicit
# deals.aff_url always wins over these; reader-submitted links are never
# rewritten. Leave both empty to disable.
#   AFF_QUERY: a full query string appended to the booking URL, e.g.
#   AFF_QUERY=marker=123456&campaign=airport-maps
# or a single parameter pair:
#   AFF_PARAM=marker
#   AFF_VALUE=123456
AFF_QUERY=
AFF_PARAM=
AFF_VALUE=